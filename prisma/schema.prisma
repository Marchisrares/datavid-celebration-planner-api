generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Member {
  id         Int      @id @default(autoincrement())
  firstName  String
  lastName   String
  birthDate  DateTime
  country    String
  city       String
  tz         String
  email      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([firstName, lastName, country, city], name: "uq_member_tuple")
}
